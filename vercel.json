{
    "rewrites":  [
                     {
                         "source":  "/((?!field-sw\\.js|manifest\\.json|assets/).*)",
                         "destination":  "/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/assets/:path*",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        }
                                    ]
                    },
                    {
                        "source":  "/field-sw.js",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache"
                                        }
                                    ]
                    },
                    {
                        "source":  "/index.html",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache"
                                        }
                                    ]
                    }
                ]
}