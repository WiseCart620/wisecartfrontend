import React, { useState, useEffect, useCallback } from 'react';
import toast, { Toaster } from 'react-hot-toast';
import { Navigate } from 'react-router-dom';
import { api } from '../../services/api';
import { useAuth, can, uiAllowed } from '../../context/AuthContext';
import PageShell from '../../components/payroll/PageShell';
import { inputCls } from '../../components/payroll/Shared';
import { exportEwt } from './birEwtExport';

const BASE = '/payroll/bir/ewt';
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const n = (v) => Number(v || 0);
const fmtDate = (s) => (s && /^\d{4}-\d{2}-\d{2}/.test(s) ? `${s.slice(5, 7)}/${s.slice(8, 10)}/${s.slice(0, 4)}` : (s || ''));
const maskDate = (v) => { const d = v.replace(/\D/g, '').slice(0, 8); return d.length > 4 ? `${d.slice(0, 2)}/${d.slice(2, 4)}/${d.slice(4)}` : d.length > 2 ? `${d.slice(0, 2)}/${d.slice(2)}` : d; };
const parseDate = (s) => {
  const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(s || '');
  if (!m) return null;
  const dt = new Date(Number(m[3]), Number(m[1]) - 1, Number(m[2]));
  if (dt.getMonth() !== Number(m[1]) - 1 || dt.getDate() !== Number(m[2])) return null;
  return `${m[3]}-${m[1]}-${m[2]}`;
};
const toB64 = (file) => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(String(r.result).split(',')[1]); r.onerror = () => rej(new Error('Could not read the file')); r.readAsDataURL(file); });
const pick = (r) => {
  if (!r || r.success === false) return null;
  let x = r.data !== undefined ? r.data : r;
  if (x && x.success === true && x.data !== undefined) x = x.data;
  return x;
};
const acc = (v) => (Math.abs(n(v)) < 0.005 ? '-' : n(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
const th = 'px-3 py-2 text-center text-xs font-semibold text-gray-700 border border-gray-300 bg-gray-100';
const td = 'px-3 py-1.5 border border-gray-200 text-xs whitespace-nowrap';
const tdN = `${td} text-right tabular-nums`;
const tdT = `${td} font-bold bg-green-100 text-right tabular-nums`;
const btn = 'px-3 py-1.5 border border-gray-300 rounded text-sm hover:bg-gray-100';
const btnP = 'px-3 py-1.5 bg-orange-600 text-white rounded text-sm hover:bg-orange-700 disabled:opacity-50';
const dl = async (kind, d, year) => {
  try { await exportEwt(kind, d, year); toast.success('Excel file downloaded'); }
  catch (e) { toast.error(e.message || 'Failed to build the Excel file'); }
};

const LineTable = ({ lines, totalBase, totalTax, baseLabel, taxLabel, showTin }) => (
  <div className="overflow-auto">
    <table className="min-w-[760px] w-full border-collapse">
      <thead><tr>
        {showTin && <th className={th}>TIN</th>}
        <th className={th}>{showTin ? 'Registered Name' : 'Description'}</th><th className={th}>ATC</th><th className={th}>Tax Rate</th>
        <th className={th}>{baseLabel}</th><th className={th}>{taxLabel}</th>
      </tr></thead>
      <tbody>
        {(lines || []).map((l) => (
          <tr key={l.payeeId}>
            {showTin && <td className={td}>{l.tin || <span className="text-amber-600">missing</span>}</td>}
            <td className={td}>{showTin ? `${l.name} (${l.description})` : l.description}</td>
            <td className={`${td} text-center`}>{l.atc}</td>
            <td className={`${td} text-center`}>{(n(l.rate) * 100).toFixed(0)}%</td>
            <td className={tdN}>{acc(l.base)}</td><td className={tdN}>{acc(l.tax)}</td>
          </tr>
        ))}
        <tr><td className={`${td} font-bold bg-green-100`} colSpan={showTin ? 4 : 3}>TOTAL</td><td className={tdT}>{acc(totalBase)}</td><td className={tdT}>{acc(totalTax)}</td></tr>
      </tbody>
    </table>
  </div>
);

const RemitBox = ({ year, form, period, remit, canEdit, onSaved, label, coverMonth }) => {
  const [f, setF] = useState({ dateRemitted: '', bank: 'UNIONBANK', paymentRef: '', amount: '' });
  useEffect(() => {
    setF({ dateRemitted: remit?.dateRemitted || '', bank: remit?.bank || 'UNIONBANK', paymentRef: remit?.paymentRef || '', amount: remit?.amount ?? '' });
  }, [remit, year, form, period]);
  const save = async () => {
    try {
      await api.put(`${BASE}/remittance`, { year, form, period, dateRemitted: f.dateRemitted || null, bank: f.bank, paymentRef: f.paymentRef, amount: f.amount === '' ? null : Number(f.amount) });
      toast.success('Saved'); onSaved();
    } catch (e) { toast.error(e.message || 'Failed to save'); }
  };
  const set = (k) => (e) => setF((p) => ({ ...p, [k]: e.target.value }));
  return (
    <div className="p-4 border-t border-gray-200 flex flex-wrap items-end gap-3">
      <span className="text-sm font-medium text-gray-700 w-full">{label}</span>
      {coverMonth && <div className="w-full text-xs text-gray-600">Payment for: <b>{MONTHS[coverMonth - 1]} {year}</b>{coverMonth % 3 === 0 ? ' (filed with the 1601-EQ)' : ''}</div>}
      <div><label className="block text-xs text-gray-600 mb-1">Date of remittance</label><input type="date" className={`${inputCls} !w-40`} value={f.dateRemitted} disabled={!canEdit} onChange={set('dateRemitted')} /></div>
      <div><label className="block text-xs text-gray-600 mb-1">Bank</label><input className={`${inputCls} !w-40`} value={f.bank} disabled={!canEdit} onChange={set('bank')} /></div>
      <div><label className="block text-xs text-gray-600 mb-1">Payment Ref. #</label><input className={`${inputCls} !w-40`} value={f.paymentRef} disabled={!canEdit} onChange={set('paymentRef')} /></div>
      <div><label className="block text-xs text-gray-600 mb-1">Amount paid</label><input type="number" step="0.01" className={`${inputCls} !w-36`} value={f.amount} disabled={!canEdit} onChange={set('amount')} /></div>
      {canEdit && <button className={btnP} onClick={save}>Save payment</button>}
    </div>
  );
};

const Report0619 = ({ year, canEdit }) => {
  const [month, setMonth] = useState(new Date().getMonth() + 1);
  const [d, setD] = useState(null);
  const load = useCallback(() => { api.get(`${BASE}/0619e?year=${year}&month=${month}`).then((r) => setD(pick(r))).catch(() => toast.error('Failed to load')); }, [year, month]);
  useEffect(() => { load(); }, [load]);
  return (
    <div>
      <div className="p-3 border-b border-gray-200 flex items-center gap-2">
        <label className="text-xs font-medium text-gray-700">Month</label>
        <select className={`${inputCls} !w-auto`} value={month} onChange={(e) => setMonth(Number(e.target.value))}>{MONTHS.map((m, i) => <option key={m} value={i + 1}>{m}</option>)}</select>
        <span className="text-xs text-gray-500">Monthly withholding tax - expanded (0619-E). Months 3, 6, 9, 12 are filed on the 1601-EQ.</span>
        {d && <button className={`${btnP} ml-auto`} onClick={() => dl('0619', d, year)}>Download Excel</button>}
      </div>
      {d && <>
        <LineTable lines={d.lines} totalBase={d.totalBase} totalTax={d.totalTax} baseLabel="Tax Base Amount" taxLabel="Tax Withheld for the Month" />
        <p className="px-4 py-2 text-sm font-semibold">Total Amount of Remittance: {acc(d.totalTax)}</p>
        <RemitBox year={year} form="0619E" period={month} remit={d.remittance} canEdit={canEdit} onSaved={load} label={`0619-E payment for the month of ${MONTHS[month - 1]} ${year}`} coverMonth={month} />
      </>}
    </div>
  );
};

const Report1601 = ({ year, canEdit }) => {
  const [q, setQ] = useState(Math.ceil((new Date().getMonth() + 1) / 3));
  const [d, setD] = useState(null);
  const load = useCallback(() => { api.get(`${BASE}/1601eq?year=${year}&quarter=${q}`).then((r) => setD(pick(r))).catch(() => toast.error('Failed to load')); }, [year, q]);
  useEffect(() => { load(); }, [load]);
  return (
    <div>
      <div className="p-3 border-b border-gray-200 flex items-center gap-2">
        <label className="text-xs font-medium text-gray-700">Quarter</label>
        <select className={`${inputCls} !w-auto`} value={q} onChange={(e) => setQ(Number(e.target.value))}>{[1, 2, 3, 4].map((x) => <option key={x} value={x}>Q{x}</option>)}</select>
        <span className="text-xs text-gray-500">Quarterly withholding tax - expanded (1601-EQ)</span>
        {d && <button className={`${btnP} ml-auto`} onClick={() => dl('1601', d, year)}>Download Excel</button>}
      </div>
      {d && <>
        <LineTable lines={d.lines} totalBase={d.totalBase} totalTax={d.totalDue} baseLabel="Tax Base for the Quarter" taxLabel="Tax Withheld for the Quarter" />
      </>}
    </div>
  );
};

const Report1604 = ({ year }) => {
  const [d, setD] = useState(null);
  const [mo, setMo] = useState(null);
  const [open, setOpen] = useState({});
  const load = useCallback(() => {
    api.get(`${BASE}/1604e?year=${year}`).then((r) => setD(pick(r))).catch(() => toast.error('Failed to load'));
    api.get(`${BASE}/1604e/months?year=${year}`).then((r) => setMo(pick(r) || [])).catch(() => toast.error('Failed to load'));
  }, [year]);
  useEffect(() => { load(); }, [load]);
  if (!d || !mo) return <p className="p-6 text-gray-500">Loading...</p>;
  const QN = ['1st Quarter', '2nd Quarter', '3rd Quarter', '4th Quarter'];
  const byMonth = (m) => mo.find((x) => x.month === m);
  const totalWithheld = mo.reduce((s, x) => s + n(x.taxesWithheld), 0);
  const totalPaid = mo.reduce((s, x) => s + n(x.remittance?.amount), 0);
  const allOpen = [0, 1, 2, 3].every((i) => open[i]);
  return (
    <div>
      <div className="px-4 pt-3 flex justify-between items-center">
        <button className={btn} onClick={() => setOpen(allOpen ? {} : { 0: true, 1: true, 2: true, 3: true })}>{allOpen ? 'Collapse all' : 'Expand all'}</button>
        <button className={btnP} onClick={() => dl('1604', { ...d, months: mo }, year)}>Download Excel (summary + alphalist)</button>
      </div>
      <div className="p-4 overflow-auto">
        <table className="border-collapse min-w-[640px]">
          <thead><tr>{['QUARTER / MONTH', 'DATE OF REMITTANCE', 'BANK', 'Payment Ref. #', 'TAXES WITHHELD', 'AMOUNT PAID'].map((h) => <th key={h} className={th}>{h}</th>)}</tr></thead>
          <tbody>
            {[0, 1, 2, 3].map((qi) => {
              const ms = [qi * 3 + 1, qi * 3 + 2, qi * 3 + 3];
              const rows = ms.map(byMonth);
              const tw = rows.reduce((s, r) => s + n(r?.taxesWithheld), 0);
              const tp = rows.reduce((s, r) => s + n(r?.remittance?.amount), 0);
              const isOpen = !!open[qi];
              return (
                <React.Fragment key={qi}>
                  <tr className="bg-gray-50 cursor-pointer hover:bg-gray-100" onClick={() => setOpen((p) => ({ ...p, [qi]: !p[qi] }))}>
                    <td className={`${td} font-semibold`} colSpan={4}>
                      <span className="inline-block w-4">{isOpen ? '\u25BE' : '\u25B8'}</span>
                      {QN[qi]} <span className="font-normal text-gray-500">({MONTHS[ms[0] - 1].slice(0, 3)} - {MONTHS[ms[2] - 1].slice(0, 3)})</span>
                    </td>
                    <td className={`${tdN} font-semibold`}>{acc(tw)}</td>
                    <td className={`${tdN} font-semibold`}>{acc(tp)}</td>
                  </tr>
                  {isOpen && ms.map((m) => {
                    const r = byMonth(m);
                    return (
                      <tr key={m}>
                        <td className={`${td} pl-9`}>{MONTHS[m - 1]}</td>
                        <td className={`${td} text-center`}>{fmtDate(r?.remittance?.dateRemitted)}</td>
                        <td className={td}>{r?.remittance?.bank || ''}</td>
                        <td className={td}>{r?.remittance?.paymentRef || ''}</td>
                        <td className={tdN}>{acc(r?.taxesWithheld)}</td>
                        <td className={tdN}>{acc(r?.remittance?.amount)}</td>
                      </tr>
                    );
                  })}
                </React.Fragment>
              );
            })}
            <tr><td className={`${td} font-bold bg-green-100`} colSpan={4}>TOTAL</td><td className={tdT}>{acc(totalWithheld)}</td><td className={tdT}>{acc(totalPaid)}</td></tr>
          </tbody>
        </table>
        <p className="text-xs text-gray-500 mt-2">Click a quarter to see its months. Date, bank, reference and amount come from the payment saved on the 0619-E tab of each month.</p>
      </div>
      <h3 className="px-4 text-sm font-semibold">ALPHALIST (1604-E)</h3>
      <div className="p-4"><LineTable showTin lines={d.alphalist} totalBase={d.totalBase} totalTax={d.totalTax} baseLabel="Annual Income Payment" taxLabel="Annual Tax Withheld" /></div>
    </div>
  );
};
const blankPayee = { companyId: '', tin: '', registeredName: '', description: '', atc: 'WC160', rate: '2', sortOrder: '0' };
const EwtModal = ({ title, onClose, onSave, saveLabel, children }) => {
  useEffect(() => {
    const h = (e) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', h);
    return () => window.removeEventListener('keydown', h);
  }, [onClose]);
  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose(); }}>
      <div className="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-auto">
        <div className="flex items-center justify-between px-5 py-3 border-b border-gray-200">
          <h3 className="text-sm font-semibold">{title}</h3>
          <button className="text-gray-500 hover:text-gray-800 text-lg leading-none" onClick={onClose} aria-label="Close">&times;</button>
        </div>
        <div className="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">{children}</div>
        <div className="flex justify-end gap-2 px-5 py-3 border-t border-gray-200">
          <button className={btn} onClick={onClose}>Cancel</button>
          <button className={btnP} onClick={onSave}>{saveLabel}</button>
        </div>
      </div>
    </div>
  );
};

const DataEntry = ({ year, canEdit }) => {
  const [sub, setSub] = useState('entries');
  const [showAdd, setShowAdd] = useState(false);
  const [showPay, setShowPay] = useState(false);
  const [month, setMonth] = useState(new Date().getMonth() + 1);
  const [payees, setPayees] = useState([]);
  const [rows, setRows] = useState([]);
  const [extras, setExtras] = useState({});
  const [companies, setCompanies] = useState([]);
  const [np, setNp] = useState(blankPayee);
  const [ne, setNe] = useState({ payeeId: '', invDate: '', reference: '', gross: '', vat: true, taxBase: '', file: null, fileKey: 0 });
  const [fe, setFe] = useState({ payee: '', q: '' });
  const [fp, setFp] = useState({ q: '', atc: '', link: '' });

  const loadP = useCallback(() => { api.get(`${BASE}/payees`).then((r) => setPayees(pick(r) || [])).catch(() => {}); }, []);
  const loadE = useCallback(() => {
    const months = month === 0 ? Array.from({ length: 12 }, (_, i) => i + 1) : [month];
    Promise.all(months.map((m) => Promise.all([
      api.get(`${BASE}/entries?year=${year}&month=${m}`),
      api.get(`${BASE}/entries/extras?year=${year}&month=${m}`).catch(() => null),
    ]))).then((res) => {
      const list = []; const ex = {};
      res.forEach(([a, b]) => { (pick(a) || []).forEach((x) => list.push(x)); (pick(b) || []).forEach((x) => { ex[x.id] = x; }); });
      setRows(list); setExtras(ex);
    }).catch(() => toast.error('Failed to load'));
  }, [year, month]);
  useEffect(() => { loadP(); }, [loadP]);
  useEffect(() => { loadE(); }, [loadE]);
  useEffect(() => { api.get(`${BASE}/companies`).then((r) => setCompanies(pick(r) || [])).catch(() => {}); }, []);

  const active = payees.filter((p) => p.active);
  const nameOf = (id) => { const p = payees.find((x) => x.id === id); return p ? `${p.registeredName} (${p.description})` : id; };
  const calcBase = (gross, vat) => (gross === '' ? '' : String(vat ? Math.round((Number(gross) / 1.12) * 100) / 100 : Number(gross)));
  const sel = active.find((p) => String(p.id) === String(ne.payeeId));

  const pickCompany = (id) => {
    const c = companies.find((x) => String(x.id) === String(id));
    setNp((p) => ({ ...p, companyId: id, tin: c ? (c.tin || '') : p.tin, registeredName: c ? c.name : p.registeredName }));
  };
  const linkAll = async () => {
    try { const r = await api.post(`${BASE}/payees/link-companies`, {}); toast.success(`${pick(r)?.linked ?? 0} payee(s) linked to Branches & Companies`); loadP(); }
    catch (e) { toast.error(e.message || 'Failed'); }
  };
  const addPayee = async () => {
    if (!np.registeredName.trim() || !np.atc.trim()) { toast.error('Name and ATC are required'); return; }
    try {
      await api.post(`${BASE}/payees`, { ...np, companyId: np.companyId ? Number(np.companyId) : null, rate: Number(np.rate || 0) / 100, sortOrder: Number(np.sortOrder || 0) });
      setNp(blankPayee); setShowPay(false); loadP(); toast.success('Payee added');
    } catch (e) { toast.error(e.message || 'Failed'); }
  };
  const removePayee = async (id) => { try { await api.delete(`${BASE}/payees/${id}`); loadP(); } catch (e) { toast.error(e.message || 'Failed'); } };

  const addEntry = async () => {
    if (!ne.payeeId || ne.taxBase === '') { toast.error('Choose a payee and enter the amount'); return; }
    const iso = ne.invDate;
    if (!iso) { toast.error('Pick the invoice date'); return; }
    if (Number(iso.slice(0, 4)) !== year) { toast.error(`The invoice date is in ${iso.slice(0, 4)}. Change the year at the top first.`); return; }
    try {
      const fileBody = ne.file ? { fileName: ne.file.name, fileType: ne.file.type, fileBase64: await toB64(ne.file) } : {};
      await api.post(`${BASE}/entries/invoice`, { payeeId: Number(ne.payeeId), invoiceDate: iso, reference: ne.reference, taxBase: Number(ne.taxBase), remarks: ne.gross ? ('Invoice total ' + ne.gross) : '', ...fileBody });
      if (month !== 0) setMonth(Number(iso.slice(5, 7)));
      setNe((p) => ({ ...p, reference: '', gross: '', taxBase: '', file: null, fileKey: (p.fileKey || 0) + 1 }));
      setShowAdd(false); loadE(); toast.success('Added');
    } catch (e) { toast.error(e.message || 'Failed'); }
  };
  const delEntry = async (id) => { try { await api.delete(`${BASE}/entries/${id}`); loadE(); } catch (e) { toast.error(e.message || 'Failed'); } };
  const openInvoice = async (id) => {
    try {
      const d = pick(await api.get(`${BASE}/entries/${id}/attachment`));
      const bin = atob(d.base64); const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      window.open(URL.createObjectURL(new Blob([bytes], { type: d.type || 'application/octet-stream' })), '_blank');
    } catch (e) { toast.error(e.message || 'Failed to open the file'); }
  };
  const attachTo = async (id, file) => {
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) { toast.error('File is over 10 MB'); return; }
    try {
      await api.post(`${BASE}/entries/${id}/attachment`, { fileName: file.name, fileType: file.type, fileBase64: await toB64(file) });
      loadE(); toast.success('Attached');
    } catch (e) { toast.error(e.message || 'Failed'); }
  };

  const qe = fe.q.trim().toLowerCase();
  const shownRows = rows
    .filter((r) => !fe.payee || String(r.payeeId) === String(fe.payee))
    .filter((r) => !qe || `${r.reference || ''} ${nameOf(r.payeeId)}`.toLowerCase().includes(qe))
    .sort((a, b) => String(extras[b.id]?.invoiceDate || '').localeCompare(String(extras[a.id]?.invoiceDate || '')) || b.id - a.id);
  const totalBase = shownRows.reduce((s, r) => s + n(r.taxBase), 0);

  const qp = fp.q.trim().toLowerCase();
  const atcs = Array.from(new Set(active.map((p) => p.atc).filter(Boolean)));
  const shownPayees = active
    .filter((p) => !qp || `${p.tin || ''} ${p.registeredName || ''} ${p.description || ''}`.toLowerCase().includes(qp))
    .filter((p) => !fp.atc || p.atc === fp.atc)
    .filter((p) => !fp.link || (fp.link === 'linked' ? !!p.companyId : fp.link === 'unlinked' ? !p.companyId : !p.tin));

  const subBtn = (k, label) => (
    <button key={k} onClick={() => setSub(k)} className={`px-3 py-1.5 rounded text-xs font-medium border ${sub === k ? 'bg-orange-600 text-white border-orange-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-100'}`}>{label}</button>
  );
  const lbl = 'block text-xs text-gray-600 mb-1';
  const cf = `${inputCls} !w-auto !py-1 !text-xs`;
  const btnS = 'px-2.5 py-1 bg-white text-gray-700 border border-gray-300 rounded text-xs hover:bg-gray-100';
  const btnPS = 'px-3 py-1 bg-orange-600 text-white rounded text-xs hover:bg-orange-700';

  return (
    <div className="p-4 space-y-3">
      <div className="flex gap-1">
        {subBtn('entries', `Tax base entries - ${year}`)}
        {subBtn('payees', 'Payees / withholding lines')}
      </div>

      {sub === 'entries' && (
        <section className="space-y-3">
          <div className="flex flex-wrap items-center gap-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded">
            <select className={cf} title="Month" value={month} onChange={(e) => setMonth(Number(e.target.value))}>
              <option value={0}>All months</option>{MONTHS.map((m, i) => <option key={m} value={i + 1}>{m}</option>)}</select>
            <select className={`${cf} max-w-[14rem]`} title="Payee" value={fe.payee} onChange={(e) => setFe((p) => ({ ...p, payee: e.target.value }))}>
              <option value="">All payees</option>{active.map((p) => <option key={p.id} value={p.id}>{p.registeredName} - {p.description}</option>)}</select>
            <input className={`${cf} !w-44`} placeholder="Search reference / payee" value={fe.q} onChange={(e) => setFe((p) => ({ ...p, q: e.target.value }))} />
            <button className={btnS} onClick={() => { setFe({ payee: '', q: '' }); setMonth(new Date().getMonth() + 1); }}>Clear</button>
            {canEdit && <button className={`${btnPS} ml-auto`} onClick={() => setShowAdd(true)}>+ Add entry</button>}
          </div>

          {showAdd && (
            <EwtModal title={`Add tax base entry - ${year}`} onClose={() => setShowAdd(false)} onSave={addEntry} saveLabel="Add">
              <div className="sm:col-span-2"><label className={lbl}>Payee</label>
                <select className={`${inputCls} !w-full`} value={ne.payeeId} onChange={(e) => setNe((p) => ({ ...p, payeeId: e.target.value }))}>
                  <option value="">Select...</option>{active.map((p) => <option key={p.id} value={p.id}>{p.registeredName} - {p.description}</option>)}</select></div>
              <div><label className={lbl}>Invoice date</label>
                <input type="date" className={`${inputCls} !w-full`} min={`${year}-01-01`} max={`${year}-12-31`} value={ne.invDate}
                  onChange={(e) => { const v = e.target.value; setNe((p) => ({ ...p, invDate: v })); if (v && month !== 0) setMonth(Number(v.slice(5, 7))); }} /></div>
              <div><label className={lbl}>Reference (invoice / SI no.)</label><input className={`${inputCls} !w-full`} value={ne.reference} onChange={(e) => setNe((p) => ({ ...p, reference: e.target.value }))} /></div>
              <div><label className={lbl}>Invoice total (VAT incl.)</label><input type="number" step="0.01" className={`${inputCls} !w-full`} value={ne.gross} onChange={(e) => setNe((p) => ({ ...p, gross: e.target.value, taxBase: calcBase(e.target.value, p.vat) }))} /></div>
              <div className="flex items-end pb-2"><label className="flex items-center gap-1 text-xs text-gray-700"><input type="checkbox" checked={ne.vat} onChange={(e) => setNe((p) => ({ ...p, vat: e.target.checked, taxBase: p.gross === '' ? p.taxBase : calcBase(p.gross, e.target.checked) }))} /> VAT-registered (total / 1.12)</label></div>
              <div><label className={lbl}>Tax base amount</label><input type="number" step="0.01" className={`${inputCls} !w-full`} value={ne.taxBase} onChange={(e) => setNe((p) => ({ ...p, taxBase: e.target.value }))} /></div>
              <div className="flex items-end pb-2 text-xs text-gray-600">{ne.taxBase !== '' && sel ? <span>Tax to withhold: <b>{acc(Math.round(Number(ne.taxBase) * Number(sel.rate) * 100) / 100)}</b></span> : null}</div>
              <div className="sm:col-span-2"><label className={lbl}>Attach invoice (image / PDF)</label><input key={ne.fileKey} type="file" accept="image/*,application/pdf" className="text-xs" onChange={(e) => { const fl = e.target.files && e.target.files[0] ? e.target.files[0] : null; if (fl && fl.size > 10 * 1024 * 1024) { toast.error('File is over 10 MB'); e.target.value = ''; return; } setNe((p) => ({ ...p, file: fl })); }} /></div>
            </EwtModal>
          )}

          <table className="border-collapse min-w-[700px]">
            <thead><tr><th className={th}>Date</th><th className={th}>Payee</th><th className={th}>Reference</th><th className={th}>Tax base</th><th className={th}>Invoice</th><th className={th} /></tr></thead>
            <tbody>
              {shownRows.length === 0 ? <tr><td colSpan="6" className="px-4 py-6 text-center text-gray-500 text-sm">No entries found for {month === 0 ? 'all months' : MONTHS[month - 1]} {year}</td></tr>
                : shownRows.map((r) => (
                  <tr key={r.id}><td className={td}>{fmtDate(extras[r.id]?.invoiceDate)}</td><td className={td}>{nameOf(r.payeeId)}</td><td className={td}>{r.reference}</td><td className={tdN}>{acc(r.taxBase)}</td>
                    <td className={td}>{extras[r.id]?.attachmentName ? <button className="text-xs text-blue-600 hover:underline" onClick={() => openInvoice(r.id)}>View</button> : (canEdit ? <label className="text-xs text-blue-600 hover:underline cursor-pointer">Attach<input type="file" accept="image/*,application/pdf" className="hidden" onChange={(e) => attachTo(r.id, e.target.files && e.target.files[0])} /></label> : '')}</td>
                    <td className={td}>{canEdit && <button className="text-xs text-red-600 hover:underline" onClick={() => delEntry(r.id)}>Delete</button>}</td></tr>
                ))}
              {shownRows.length > 0 && <tr><td className={`${td} font-bold bg-green-100`} colSpan={3}>TOTAL ({shownRows.length})</td><td className={tdT}>{acc(totalBase)}</td><td className={td} colSpan={2} /></tr>}
            </tbody>
          </table>
        </section>
      )}

      {sub === 'payees' && (
        <section className="space-y-3">
          <div className="flex flex-wrap items-center gap-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded">
            <input className={`${cf} !w-56`} placeholder="Search TIN / name / label" value={fp.q} onChange={(e) => setFp((p) => ({ ...p, q: e.target.value }))} />
            <select className={cf} title="ATC" value={fp.atc} onChange={(e) => setFp((p) => ({ ...p, atc: e.target.value }))}>
              <option value="">All ATC</option>{atcs.map((a) => <option key={a} value={a}>{a}</option>)}</select>
            <select className={cf} title="Status" value={fp.link} onChange={(e) => setFp((p) => ({ ...p, link: e.target.value }))}>
              <option value="">All status</option><option value="linked">Linked to company</option><option value="unlinked">Not linked</option><option value="notin">Missing TIN</option></select>
            <button className={btnS} onClick={() => setFp({ q: '', atc: '', link: '' })}>Clear</button>
            {canEdit && <div className="ml-auto flex items-center gap-2">
              <button className={btnS} onClick={linkAll}>Link payees to companies by TIN</button>
              <button className={btnPS} onClick={() => setShowPay(true)}>+ Add payee</button>
            </div>}
          </div>

          {showPay && (
            <EwtModal title="Add payee / withholding line" onClose={() => setShowPay(false)} onSave={addPayee} saveLabel="Add payee">
              <div className="sm:col-span-2"><label className={lbl}>From Branches & Companies</label>
                <select className={`${inputCls} !w-full`} value={np.companyId} onChange={(e) => pickCompany(e.target.value)}>
                  <option value="">Type manually...</option>{companies.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}</select></div>
              {[['tin', 'TIN'], ['registeredName', 'Registered name'], ['description', 'Line label'], ['atc', 'ATC'], ['rate', 'Rate %']].map(([k, l]) => (
                <div key={k}><label className={lbl}>{l}</label>
                  <input className={`${inputCls} !w-full`} value={np[k]} onChange={(e) => setNp((p) => ({ ...p, [k]: e.target.value }))} /></div>
              ))}
            </EwtModal>
          )}

          <table className="border-collapse min-w-[640px]">
            <thead><tr>{['TIN', 'Registered name', 'Line label', 'ATC', 'Rate', 'Company', ''].map((h) => <th key={h} className={th}>{h}</th>)}</tr></thead>
            <tbody>
              {shownPayees.length === 0 ? <tr><td colSpan="7" className="px-4 py-6 text-center text-gray-500 text-sm">No payees found</td></tr>
                : shownPayees.map((p) => (
                  <tr key={p.id}><td className={td}>{p.tin || <span className="text-amber-600">missing</span>}</td><td className={td}>{p.registeredName}</td><td className={td}>{p.description}</td>
                    <td className={`${td} text-center`}>{p.atc}</td><td className={`${td} text-center`}>{(n(p.rate) * 100).toFixed(0)}%</td>
                    <td className={`${td} text-center`}>{p.companyId ? 'linked' : '-'}</td>
                    <td className={td}>{canEdit && <button className="text-xs text-red-600 hover:underline" onClick={() => removePayee(p.id)}>Deactivate</button>}</td></tr>
                ))}
            </tbody>
          </table>
        </section>
      )}
    </div>
  );
};
const TABS = [['0619', '0619-E (Monthly)'], ['1601', '1601-EQ (Quarterly)'], ['1604', '1604-E (Annual)'], ['entry', 'Data Entry']];

const BirWithholding = () => {
  const { user } = useAuth();
  const thisYear = new Date().getFullYear();
  const [year, setYear] = useState(thisYear);
  const [tab, setTab] = useState('0619');
  if (!uiAllowed(user, 'payroll_tabs', 'tab_an')) return <Navigate to="/welcome" replace />;
  const canEdit = can(user, 'payroll', 'create');
  const action = (
    <select className={`${inputCls} !w-auto`} value={year} onChange={(e) => setYear(Number(e.target.value))}>
      {Array.from({ length: 5 }, (_, i) => thisYear + 1 - i).map((y) => <option key={y} value={y}>{y}</option>)}
    </select>
  );
  return (
    <PageShell title="BIR Expanded Withholding Tax" subtitle="0619-E monthly, 1601-EQ quarterly and 1604-E annual" action={action}>
      <Toaster position="top-right" />
      <div className="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div className="flex flex-wrap gap-1 p-3 border-b border-gray-200">
          {TABS.map(([k, label]) => (
            <button key={k} onClick={() => setTab(k)} className={`px-3 py-1.5 rounded text-xs font-medium border ${tab === k ? 'bg-orange-600 text-white border-orange-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-100'}`}>{label}</button>
          ))}
        </div>
        {tab === '0619' && <Report0619 year={year} canEdit={canEdit} />}
        {tab === '1601' && <Report1601 year={year} canEdit={canEdit} />}
        {tab === '1604' && <Report1604 year={year} />}
        {tab === 'entry' && <DataEntry year={year} canEdit={canEdit} />}
      </div>
    </PageShell>
  );
};

export default BirWithholding;
